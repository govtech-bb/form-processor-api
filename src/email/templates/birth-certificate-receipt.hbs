<html>
  <head>
    <meta charset='utf-8' />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif; line-height: 1.6; color: #333;
      margin: 0; padding: 0; } .container { max-width: 600px; margin: 0 auto;
      padding: 20px; } h1 { color: #003087; border-bottom: 3px solid #FFB71B;
      padding-bottom: 10px; margin-bottom: 20px; font-size: 24px; }
      .footer { margin-top: 30px; padding-top: 20px;
      border-top: 1px solid #ccc; color: #666; font-size: 12px; text-align:
      left; } .success-banner { margin-bottom: 25px; font-size: 16px;
      background-color: #d4edda; padding: 20px; border-left: 4px solid #28a745;
      border-radius: 4px; } .success-banner p { margin: 0; color: #155724; }
      .reference-box {
      background-color: #e7f3ff; padding: 15px; border-radius: 4px; margin: 20px 0;
      border: 1px solid #b8daff; } .reference-box strong { color: #004085; }
      .payment-info { background-color: #f8f9fa; padding: 15px; border-radius: 4px;
      margin: 20px 0; } .payment-info table { width: 100%; border-collapse: collapse; }
      .payment-info td { padding: 8px 0; } .payment-info td:first-child { font-weight: bold; width: 40%; }
    </style>
  </head>
  <body>
    <div class='container'>
      <h1>Birth Certificate Application Received</h1>

      <div class='success-banner'>
        <p>Thank you for submitting your birth certificate application.</p>
        <p>Your payment has been processed successfully and your application is now being reviewed.</p>
      </div>

      <div class='reference-box'>
        <strong>Reference Number:</strong> {{submissionId}}<br />
        <small>Please keep this reference number for your records.</small>
      </div>

      {{#if paymentInfo}}
      <div class='payment-info'>
        <h3 style="margin-top: 0; color: #003087;">Payment Details</h3>
        <table>
          {{#if paymentInfo.transactionNumber}}
          <tr>
            <td>Transaction Number:</td>
            <td>{{paymentInfo.transactionNumber}}</td>
          </tr>
          {{/if}}
          {{#if paymentInfo.amount}}
          <tr>
            <td>Amount Paid:</td>
            <td>${{paymentInfo.amount}}</td>
          </tr>
          {{/if}}
        </table>
      </div>
      {{/if}}

      <p>
        <strong>What happens next?</strong><br />
        Your application will be processed by the Registration Department.
        Please allow 5-10 business days for processing.
      </p>

      <!-- Footer -->
      <div class='footer'>
        <p>
          This is an automated confirmation from the Government of Barbados.<br /><br />
          If you have any questions about your application, please contact the Registration Department
          with your reference number: <strong>{{submissionId}}</strong><br /><br />
          <em>Please do not reply to this email.</em>
        </p>
      </div>
    </div>
  </body>
</html>
