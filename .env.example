# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=forms_processor_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_FROM_EMAIL=noreply@example.com

# Optional: CloudWatch Configuration Set for email tracking/analytics
# SES_CONFIGURATION_SET=your-configuration-set-name
# SES_TAG_KEY=ses:configuration-set
# SES_TAG_VALUE=prod

# Email Templates Directory
EMAIL_TEMPLATES_DIR=src/email/templates

# Form Schemas Directory
FORM_SCHEMAS_DIR=schemas
