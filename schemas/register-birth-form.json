{
  "id": "register-birth-form",
  "name": "Register a Birth Form",
  "description": "Multi-step form for registering a birth in Barbados with conditional flows based on marriage status",
  "fields": [
    {
      "name": "marriageStatus",
      "type": "string",
      "required": true,
      "validations": {
        "regex": "^(yes|no)$",
        "message": "Must be 'yes' or 'no'"
      }
    },
    {
      "name": "includeFatherDetails",
      "type": "string",
      "required": false,
      "validations": {
        "regex": "^(yes|no)$",
        "message": "Must be 'yes' or 'no'"
      }
    },
    {
      "name": "father",
      "type": "object",
      "required": false,
      "fields": [
        {
          "name": "firstName",
          "type": "string",
          "required": false,
          "validations": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "middleName",
          "type": "string",
          "required": false,
          "validations": {
            "max": 200
          }
        },
        {
          "name": "lastName",
          "type": "string",
          "required": false,
          "validations": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "hadOtherSurname",
          "type": "string",
          "required": false,
          "validations": {
            "regex": "^(yes|no)$"
          }
        },
        {
          "name": "otherSurname",
          "type": "string",
          "required": false,
          "validations": {
            "max": 100
          }
        },
        {
          "name": "dateOfBirth",
          "type": "date",
          "required": false
        },
        {
          "name": "address",
          "type": "string",
          "required": false,
          "validations": {
            "max": 500
          }
        },
        {
          "name": "nationalRegistrationNumber",
          "type": "string",
          "required": false,
          "validations": {
            "regex": "^\\d{6}-\\d{4}$",
            "message": "Must be in format XXXXXX-XXXX"
          }
        },
        {
          "name": "passportNumber",
          "type": "string",
          "required": false,
          "validations": {
            "max": 50
          }
        },
        {
          "name": "passportPlaceOfIssue",
          "type": "string",
          "required": false,
          "validations": {
            "max": 100
          }
        },
        {
          "name": "occupation",
          "type": "string",
          "required": false,
          "validations": {
            "max": 100
          }
        }
      ]
    },
    {
      "name": "mother",
      "type": "object",
      "required": true,
      "fields": [
        {
          "name": "firstName",
          "type": "string",
          "required": true,
          "validations": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "middleName",
          "type": "string",
          "required": false,
          "validations": {
            "max": 200
          }
        },
        {
          "name": "lastName",
          "type": "string",
          "required": true,
          "validations": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "hadOtherSurname",
          "type": "string",
          "required": false,
          "validations": {
            "regex": "^(yes|no)$"
          }
        },
        {
          "name": "otherSurname",
          "type": "string",
          "required": false,
          "validations": {
            "max": 100
          }
        },
        {
          "name": "dateOfBirth",
          "type": "date",
          "required": true
        },
        {
          "name": "address",
          "type": "string",
          "required": true,
          "validations": {
            "min": 5,
            "max": 500
          }
        },
        {
          "name": "nationalRegistrationNumber",
          "type": "string",
          "required": false,
          "validations": {
            "regex": "^\\d{6}-\\d{4}$",
            "message": "Must be in format XXXXXX-XXXX"
          }
        },
        {
          "name": "passportNumber",
          "type": "string",
          "required": false,
          "validations": {
            "max": 50
          }
        },
        {
          "name": "passportPlaceOfIssue",
          "type": "string",
          "required": false,
          "validations": {
            "max": 100
          }
        },
        {
          "name": "occupation",
          "type": "string",
          "required": true,
          "validations": {
            "min": 1,
            "max": 100
          }
        }
      ]
    },
    {
      "name": "child",
      "type": "object",
      "required": true,
      "fields": [
        {
          "name": "firstNames",
          "type": "string",
          "required": true,
          "validations": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "middleNames",
          "type": "string",
          "required": false,
          "validations": {
            "max": 200
          }
        },
        {
          "name": "lastName",
          "type": "string",
          "required": true,
          "validations": {
            "min": 1,
            "max": 100
          }
        },
        {
          "name": "dateOfBirth",
          "type": "date",
          "required": true
        },
        {
          "name": "sexAtBirth",
          "type": "string",
          "required": true,
          "validations": {
            "regex": "^(Male|Female)$",
            "message": "Must be 'Male' or 'Female'"
          }
        },
        {
          "name": "parishOfBirth",
          "type": "string",
          "required": true,
          "validations": {
            "min": 1,
            "max": 100
          }
        }
      ]
    },
    {
      "name": "numberOfCertificates",
      "type": "number",
      "required": true,
      "validations": {
        "min": 0,
        "max": 20
      }
    },
    {
      "name": "email",
      "type": "email",
      "required": true
    },
    {
      "name": "phoneNumber",
      "type": "string",
      "required": true,
      "validations": {
        "min": 7,
        "max": 20
      }
    }
  ],
  "processors": [
    {
      "type": "email",
      "config": {
        "to": "{{db:register-birth-form:admin_email}}",
        "subject": "New Birth Registration - {{formData.child.firstNames}} {{formData.child.lastName}}",
        "template": "birth-registration"
      }
    },
    {
      "type": "email",
      "config": {
        "to": "{{formData.email}}",
        "subject": "Birth Registration Received - Government of Barbados",
        "template": "birth-registration-receipt"
      }
    }
  ]
}
