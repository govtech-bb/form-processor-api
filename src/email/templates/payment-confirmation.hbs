<html>
  <head>
    <meta charset='utf-8' />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif; line-height: 1.6; color: #333;
      margin: 0; padding: 0; } .container { max-width: 800px; margin: 0 auto;
      padding: 20px; } h1 { color: #003087; border-bottom: 3px solid #FFB71B;
      padding-bottom: 10px; margin-bottom: 20px; font-size: 28px; } h2 { color:
      #003087; font-size: 20px; margin-top: 30px; margin-bottom: 15px; }
      table { width: 100%; border-collapse: collapse; margin-bottom: 20px; } td
      { padding: 8px 12px; border-bottom: 1px solid #eee; } td:first-child {
      background-color: #f5f5f5; font-weight: bold; width: 40%; } .section {
      margin-top: 20px; } .footer { margin-top: 30px; padding-top: 20px;
      border-top: 1px solid #ccc; color: #666; font-size: 12px; text-align:
      left; } .info-box { margin-bottom: 20px; font-size: 16px;
      background-color: #e7f3ff; padding: 15px; border-left: 4px solid #004085;
      border-radius: 4px; } .warning-box { background-color: #fff3cd; padding: 15px; border: 1px solid
      #ffeaa7; border-radius: 4px; margin: 20px 0; } .reference-highlight {
      font-size: 18px; font-weight: bold; color: #003087; }
    </style>
  </head>
  <body>
    <div class='container'>
      <h1>{{formName}} payment</h1>

      <div class='info-box'>
        <p>You have received payment for a {{formName}}.</p>
        <p class='reference-highlight'>Reference number: {{submissionId}}</p>
      </div>

      <!-- Payment Details -->
      <section class='section'>
        <h2>Payment Details</h2>
        <table>
          <tbody>
            <tr>
              <td>Payment amount received:</td>
              <td>${{amount}}</td>
            </tr>
            <tr>
              <td>EZPay transaction ID:</td>
              <td>{{transactionNumber}}</td>
            </tr>
            {{#if processor}}
            <tr>
              <td>Payment Method:</td>
              <td>{{processor}}</td>
            </tr>
            {{/if}}
            {{#if processedAt}}
            <tr>
              <td>Payment Date:</td>
              <td>{{processedAt}}</td>
            </tr>
            {{/if}}
          </tbody>
        </table>
      </section>

      <!-- Important Notice -->
      <div class='warning-box'>
        <strong>Before you can process the request for a {{formName}}, you need 2 emails with matching reference numbers in the subject lines:</strong>
        <ol>
          <li>A payment confirmation email (this email)</li>
          <li>A certificate request email (a separate email with the subject line: Reference number: {{submissionId}} ({{formName}} request))</li>
        </ol>
      </div>

      <!-- Customer Information -->
      <section class='section'>
        <h2>Customer Information</h2>
        <table>
          <tbody>
            <tr>
              <td>Name:</td>
              <td>{{customerName}}</td>
            </tr>
            <tr>
              <td>Email:</td>
              <td>{{customerEmail}}</td>
            </tr>
          </tbody>
        </table>
      </section>

      {{#if description}}
      <section class='section'>
        <h2>Description</h2>
        <p>{{description}}</p>
      </section>
      {{/if}}

      <!-- Footer -->
      <div class='footer'>
        <p>
          This is an automated payment confirmation email from the Government of Barbados Forms
          Processing System.<br /><br />
          <strong>Form ID:</strong> {{formId}}<br />
          <strong>Reference Number:</strong> {{submissionId}}
        </p>
      </div>
    </div>
  </body>
</html>
